<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agriware_external_system_list" model="ir.ui.view">
        <field name="name">agriware.external.system.list</field>
        <field name="model">agriware.external.system</field>
        <field name="arch" type="xml">
            <list string="External Systems">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_agriware_external_system_form" model="ir.ui.view">
        <field name="name">agriware.external.system.form</field>
        <field name="model">agriware.external.system</field>
        <field name="arch" type="xml">
            <form string="External System">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Main Warehouse WMS"/>
                        <field name="code" placeholder="e.g. primary_wms"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agriware_external_systems" model="ir.actions.act_window">
        <field name="name">External Systems</field>
        <field name="res_model">agriware.external.system</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No external systems registered yet.
            </p>
            <p>
                Register the warehouse management system(s) this company
                integrates with. Each registered system gets its own
                namespace for external ID mappings, so rotating an API
                key never affects existing mappings.
            </p>
        </field>
    </record>

    <!-- Read-only: mappings are created and managed by the mapping
         service (future REST endpoints), not hand-edited by
         administrators; see security/ir.model.access.csv, which
         grants this group read access only. -->
    <record id="view_agriware_external_id_mapping_list" model="ir.ui.view">
        <field name="name">agriware.external.id.mapping.list</field>
        <field name="model">agriware.external.id.mapping</field>
        <field name="arch" type="xml">
            <list string="External ID Mappings" create="0" edit="0" delete="0">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="external_system_id"/>
                <field name="res_model"/>
                <field name="external_id"/>
                <field name="res_id"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <record id="action_agriware_external_id_mappings" model="ir.actions.act_window">
        <field name="name">External ID Mappings</field>
        <field name="res_model">agriware.external.id.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No external ID mappings yet.
            </p>
            <p>
                Mappings are created automatically as external systems
                synchronize data with Odoo. This screen is read-only.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_agriware_external_systems_root"
        name="External Systems"
        parent="menu_agriware_root"
        sequence="30"
        groups="agriware_connector.group_agriware_administrator"
    />

    <menuitem
        id="menu_agriware_external_systems"
        name="External Systems"
        parent="menu_agriware_external_systems_root"
        action="action_agriware_external_systems"
        sequence="10"
        groups="agriware_connector.group_agriware_administrator"
    />

    <menuitem
        id="menu_agriware_external_id_mappings"
        name="ID Mappings"
        parent="menu_agriware_external_systems_root"
        action="action_agriware_external_id_mappings"
        sequence="20"
        groups="agriware_connector.group_agriware_administrator"
    />

</odoo>
