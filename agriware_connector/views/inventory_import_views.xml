<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agriware_inventory_import_list" model="ir.ui.view">
        <field name="name">agriware.inventory.import.list</field>
        <field name="model">agriware.inventory.import</field>
        <field name="arch" type="xml">
            <list string="Inventory Imports" decoration-warning="state == 'stale'" decoration-muted="state == 'rejected'" decoration-success="state == 'approved'">
                <field name="external_reference"/>
                <field name="external_system_id"/>
                <field name="warehouse_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="submitted_at"/>
                <field name="submitted_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_agriware_inventory_import_form" model="ir.ui.view">
        <field name="name">agriware.inventory.import.form</field>
        <field name="model">agriware.inventory.import</field>
        <field name="arch" type="xml">
            <form string="Inventory Import">
                <header>
                    <button name="action_recalculate" type="object" string="Recalculate"
                            invisible="state in ('approved', 'rejected')"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            invisible="state not in ('pending_review', 'stale')"
                            confirm="Approving only records a review decision -- it does NOT change Odoo's actual stock. Applying the counted quantities still requires a separate, manual step in Inventory's own Physical Inventory screen. Continue?"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('pending_review', 'stale')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending_review,stale,approved,rejected"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state in ('approved', 'rejected')">
                        This is a staged WMS stock observation, not an applied inventory count.
                        Odoo's actual on-hand quantities are unchanged by anything on this screen,
                        including Approve. See docs/INITIAL_INVENTORY_IMPORT.md for how to apply
                        an approved import using Inventory's native Physical Inventory screen.
                    </div>
                    <group>
                        <group>
                            <field name="external_reference"/>
                            <field name="external_system_id"/>
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="submitted_at"/>
                            <field name="submitted_by"/>
                            <field name="reviewed_by"/>
                            <field name="reviewed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list string="Lines" editable="false"
                                      decoration-warning="validation_status == 'stale'">
                                    <field name="product_id"/>
                                    <field name="external_unit_code"/>
                                    <field name="original_reported_quantity"/>
                                    <field name="uom_id"/>
                                    <field name="reported_quantity"/>
                                    <field name="current_odoo_quantity"/>
                                    <field name="proposed_difference"/>
                                    <field name="validation_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agriware_inventory_imports" model="ir.actions.act_window">
        <field name="name">Inventory Imports</field>
        <field name="res_model">agriware.inventory.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No inventory imports staged yet.
            </p>
            <p>
                A WMS submits its own stock observations here through
                <code>POST /agriware/api/v1/inventory-adjustments</code>.
                Nothing here ever changes Odoo's actual stock by itself --
                an Inventory Manager reviews each one and either rejects it
                or approves it as a recorded decision, then applies it
                manually (if still warranted) in Inventory's own Physical
                Inventory screen.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_agriware_inventory_imports"
        name="Inventory Imports"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_agriware_inventory_imports"
        sequence="95"
        groups="stock.group_stock_user"
    />

</odoo>
