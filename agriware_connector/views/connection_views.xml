<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agriware_connection_list" model="ir.ui.view">
        <field name="name">agriware.connection.list</field>
        <field name="model">agriware.connection</field>
        <field name="arch" type="xml">
            <list string="WMS Connections">
                <field name="name"/>
                <field name="api_url"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_agriware_connection_form" model="ir.ui.view">
        <field name="name">agriware.connection.form</field>
        <field name="model">agriware.connection</field>
        <field name="arch" type="xml">
            <form string="WMS Connection">

                <header>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-primary"
                    />
                    <field name="status" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="api_url"/>
                        <field name="api_key" password="True"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="action_agriware_connections" model="ir.actions.act_window">
        <field name="name">WMS Connections</field>
        <field name="res_model">agriware.connection</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_agriware_root"
        name="AgriWare Connector"
        sequence="50"
    />

    <menuitem
        id="menu_agriware_connections"
        name="WMS Connections"
        parent="menu_agriware_root"
        action="action_agriware_connections"
        sequence="10"
        groups="base.group_system"
    />

</odoo>
