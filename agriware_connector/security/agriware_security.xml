<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AgriWare Connector application privilege -->
    <record id="privilege_agriware_connector"
            model="res.groups.privilege">

        <field name="name">AgriWare Connector</field>
        <field name="sequence">50</field>

    </record>

    <!-- External WMS API integration user -->
    <record id="group_agriware_api_user"
            model="res.groups">

        <field name="name">AgriWare API User</field>

        <field name="privilege_id"
               ref="agriware_connector.privilege_agriware_connector"/>

        <!-- The API reads/writes stock.picking, stock.move, stock.quant,
             product.product, stock.warehouse, and res.partner. Without the
             underlying Inventory access, every receipt/dispatch endpoint
             would reject this group's own members with 403. -->
        <field name="implied_ids"
               eval="[(4, ref('stock.group_stock_user'))]"/>

        <field name="comment">
            Allows authorized external warehouse management systems
            to communicate with Odoo through the AgriWare API.
        </field>

    </record>

    <!-- AgriWare Connector administrator -->
    <record id="group_agriware_administrator"
            model="res.groups">

        <field name="name">AgriWare Administrator</field>

        <field name="privilege_id"
               ref="agriware_connector.privilege_agriware_connector"/>

        <field name="implied_ids"
               eval="[(4, ref('agriware_connector.group_agriware_api_user'))]"/>

        <field name="comment">
            Allows authorized administrators to configure and
            manage AgriWare Connector integrations.
        </field>

    </record>

    <!-- Each company only ever sees and manages its own API keys. -->
    <record id="rule_agriware_api_key_company" model="ir.rule">
        <field name="name">AgriWare API Key: multi-company</field>
        <field name="model_id" ref="model_agriware_api_key"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees and manages its own external systems. -->
    <record id="rule_agriware_external_system_company" model="ir.rule">
        <field name="name">AgriWare External System: multi-company</field>
        <field name="model_id" ref="model_agriware_external_system"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees its own external ID mappings. -->
    <record id="rule_agriware_external_id_mapping_company" model="ir.rule">
        <field name="name">AgriWare External ID Mapping: multi-company</field>
        <field name="model_id" ref="model_agriware_external_id_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees its own UOM mappings. -->
    <record id="rule_agriware_uom_mapping_company" model="ir.rule">
        <field name="name">AgriWare UOM Mapping: multi-company</field>
        <field name="model_id" ref="model_agriware_uom_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Each company only ever sees its own inventory imports. -->
    <record id="rule_agriware_inventory_import_company" model="ir.rule">
        <field name="name">AgriWare Inventory Import: multi-company</field>
        <field name="model_id" ref="model_agriware_inventory_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_agriware_inventory_import_line_company" model="ir.rule">
        <field name="name">AgriWare Inventory Import Line: multi-company</field>
        <field name="model_id" ref="model_agriware_inventory_import_line"/>
        <field name="domain_force">[('import_id.company_id', 'in', company_ids)]</field>
    </record>

</odoo>
